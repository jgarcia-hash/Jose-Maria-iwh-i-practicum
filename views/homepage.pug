html 
    head 
        title=`${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Object Table
        a.page-link(href="/update-cobj") Add/Update this table 
        .table-wrapper
            table.items-table
                thead
                    tr
                        th Name
                        th Species
                        th Age
                tbody
                    each pet in data
                        tr
                            td #{pet.properties.name}
                            td #{pet.properties.specie}
                            td #{pet.properties.age}
